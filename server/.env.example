APP_ENV=development
MODEL_API_BASE=https://api.deepseek.com
MODEL_ID=deepseek-flash
# 只在服务端填写，不要加入 VITE_ 变量，不要提交到 Git。
MODEL_API_KEY=
MODEL_THINKING_DISABLED=true
# 正式部署必填，至少24字符；临时可撤销，不是模型API密钥。
DEMO_ACCESS_TOKEN=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DAILY_ATTEMPT_LIMIT=100
PER_MINUTE_LIMIT=5
MAX_CONCURRENT_REQUESTS=2
QUOTA_DB=data/quota.sqlite3

